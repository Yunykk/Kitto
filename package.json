{
  "name": "Kitto",
  "private": true,
  "version": "0.1.0",
  "description": "A minimal starter for the Kitto local music player",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --project tsconfig.node.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "node --test tests/playback-order.test.mjs tests/player.test.mjs tests/audio.test.mjs tests/appearance.test.mjs tests/artwork-cache.test.mjs tests/track-metadata.test.mjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "music-metadata": "^12.3.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
